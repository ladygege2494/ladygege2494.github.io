{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u6280\u672f\u7b14\u8bb0","text":"<p>\u6b22\u8fce\u6765\u5230\u6211\u7684\u6280\u672f\u7b14\u8bb0\uff01</p> <p>\u8fd9\u91cc\u8bb0\u5f55\u4e86\u6211\u7684\u5b66\u4e60\u5386\u7a0b\u548c\u6280\u672f\u601d\u8003\uff0c\u6db5\u76d6\u524d\u7aef\u3001\u540e\u7aef\u3001\u7b97\u6cd5\u7b49\u591a\u4e2a\u9886\u57df\u3002</p>"},{"location":"#_2","title":"\u5206\u7c7b","text":"<ul> <li>ISEE: \u5fae\u7535\u5b50\u76f8\u5173\u5185\u5bb9</li> <li>CS: \u8ba1\u7b97\u673a\u79d1\u5b66</li> <li>AI: \u4eba\u5de5\u667a\u80fd</li> <li>Math: \u6570\u5b66</li> <li>Physics: \u7269\u7406</li> <li>Other: \u5176\u4ed6\u6280\u672f\u7b14\u8bb0</li> <li>\u901a\u8bc6: \u901a\u7528\u77e5\u8bc6</li> </ul>"},{"location":"Other/Git/","title":"Git","text":"<p>lec2 - 2023\u6625\u590f\u5b9e\u7528\u6280\u80fd\u62fe\u9057 \u4ece ACEE \u5b9e\u8df5\u9762 pre task\uff0c\u5230 hhgg \u7684\u8bb2\u5ea7\uff0c\u5230\u81ea\u5df1\u62bd\u7a7a\u73a9\u4e86\u4e00\u4e0b\u5b50\u518d\u5230\u79d1\u521b\u53f2\u9879\u76ee\uff0c\u6211\u79bb\u6700\u5f00\u59cb\u63a5\u89e6Git \u4e5f\u8fc7\u53bb\u597d\u4e45\u4e86\uff0c\u9646\u9646\u7eed\u7eed\u5b66\u4e86\u4e9b\uff0c\u4e00\u76f4\u6ca1\u6709\u771f\u6b63\u7684\u5e94\u7528\u573a\u666f\uff0c\u5230\u4e86\u8be5\u7528\u7684\u65f6\u5019\uff0c\u6bcf\u6b21\u90fd\u8981\u91cd\u65b0\u67e5\u4e00\u904d x \u56e0\u6b64\u81ea\u5df1\u518d\u5199\u4e00\u7bc7\u6587\u7ae0\u6574\u7406\u4e00\u4e0b\uff0c\u76ee\u7684\u662f\u8fbe\u6210\u771f\u6b63\u5185\u5316\uff0c\u52a0\u5f3a\u8bb0\u5fc6\uff0c\u7406\u89e3\u672c\u8d28\u3002</p>"},{"location":"Other/Git/#_1","title":"\u7248\u672c\u7684\u5b58\u50a8\u65b9\u5f0f","text":"<ul> <li>\u5168\u91cf\u5b58\u50a8</li> <li>\u589e\u91cf\u5b58\u50a8</li> <li>\u5feb\u7167\u5b58\u50a8\uff0cgit \u5c5e\u4e8e\u8fd9\u79cd</li> </ul>"},{"location":"Other/Git/#_2","title":"\u4e09\u5927\u533a\u57df&amp;\u56db\u79cd\u72b6\u6001","text":"<p>\u4e09\u5927\u533a\u57df\uff1a - \u5de5\u4f5c\u533a modified - \u6682\u5b58\u533a staged - \u4ed3\u5e93 committed/unmodified \u2757\u6ce8\u610f untracked \u4e0d\u5c5e\u4e8e\u4e09\u5927\u533a\u57df ![[3-RESOURCE/\u77e5\u8bc6/\u7406/\u5de5\u5177/asserts/Git/image.png]]</p>"},{"location":"Other/Git/#_3","title":"\u524d\u671f\u51c6\u5907","text":""},{"location":"Other/Git/#_4","title":"\u5b89\u88c5","text":"<p>https://git-scm.com/downloads/win (for Windows) \u9a8c\u8bc1 <code>git -v</code></p>"},{"location":"Other/Git/#_5","title":"\u914d\u7f6e","text":"<p>\u5168\u5c40\u53d8\u91cf/\u672c\u5730 <code>git config [--global/local] user. name &lt;Your Name&gt;</code>git config [--global/local] user. email ``"},{"location":"Other/Git/#git","title":"\u83b7\u53d6 git \u4ed3\u5e93","text":"<ul> <li>\u5c06\u5c1a\u672a\u8fdb\u884c\u7248\u672c\u63a7\u5236\u7684\u672c\u5730\u76ee\u5f55\u8f6c\u6362\u4e3a Git \u4ed3\u5e93 <code>git init</code></li> <li>\u4ece\u5176\u5b83\u670d\u52a1\u5668\u514b\u9686\u4e00\u4e2a\u5df2\u5b58\u5728\u7684Git\u4ed3\u5e93<code>git clone &lt;URL&gt; &lt;DirName&gt;</code></li> </ul>"},{"location":"Other/Git/#_6","title":"\u57fa\u672c\u64cd\u4f5c","text":""},{"location":"Other/Git/#_7","title":"\u68c0\u67e5\u6587\u4ef6\u72b6\u6001","text":"<p>\u8be6\u7ec6\u8f93\u51fa <code>git status</code> \u7b80\u6d01\u8f93\u51fa <code>git status [-s]</code>  - ? : \u672a\u8ffd\u8e2a  - A (DD) : \u65b0\u8ffd\u8e2a  - M (ODIFY) : \u5df2\u4fee\u6539  - D (ELETE) : \u5df2\u5220\u9664 - R (ENAME) : \u91cd\u547d\u540d  - U (NMERGED) : \u672a\u5408\u5e76 \u8f93\u51fa\u4e2d\u6709\u4e24\u680f\uff0c\u5de6\u680f\u6307\u660e\u4e86\u6682\u5b58\u533a\u7684\u72b6\u6001\uff0c\u53f3\u680f\u6307\u660e\u4e86\u5de5\u4f5c\u533a\u7684\u72b6\u6001\u3002</p>"},{"location":"Other/Git/#stagetrack","title":"\u6682\u5b58\u548c\u8ffd\u8e2a stage/track","text":"<p>\u6682\u5b58\u5df2\u4fee\u6539\u6587\u4ef6/\u5f00\u59cb\u8ffd\u8e2a\u65b0\u6587\u4ef6 <code>git add &lt;FileName/DirName/RegExp&gt;</code> \u53d6\u6d88\u6682\u5b58\u6587\u4ef6  <code>git reset HEAD &lt;FileName/DirName/RegExp&gt;</code> \u4e0d\u518d\u8ffd\u8e2a\u6587\u4ef6  <code>git rm &lt;file&gt;</code> \u505c\u6b62\u8ffd\u8e2a+\u4ece\u5de5\u4f5c\u76ee\u5f55\u4e2d\u79fb\u9664 <code>git rm --cached &lt;FileName/DirName/RegExp&gt;</code> \u53ea\u505c\u6b62\u8ffd\u8e2a\u56de\u5230 untracked \u72b6\u6001 \u6587\u4ef6\u76ee\u5f55\u4e0b\u7684<code>.gitignore</code>\u7528\u4e8e\u58f0\u660e\u4e0d\u5e0c\u671b\u88ab Git \u8ffd\u8e2a\u7684\u6587\u4ef6\u540d\u3002</p>"},{"location":"Other/Git/#diff","title":"\u6bd4\u8f83 diff","text":"<p>\u6bd4\u8f83\u6587\u4ef6\u5dee\u5f02 - \u5de5\u4f5c\u533a\u548c\u6682\u5b58\u533a<code>git diff</code> - \u6682\u5b58\u533a\u548c\u6700\u540e\u4e00\u6b21\u63d0\u4ea4 <code>git diff --staged</code></p>"},{"location":"Other/Git/#modify","title":"\u4fee\u6539 modify","text":"<p>\u64a4\u9500\u5bf9\u6587\u4ef6\u7684\u4fee\u6539 <code>git checkout -- &lt;FileName&gt;</code></p>"},{"location":"Other/Git/#commit","title":"\u63d0\u4ea4 commit","text":"<p>\u63d0\u4ea4 \uff08\u5b58\u6863\u70b9\uff09 <code>git commit</code> \u5148 add \u540e commit\uff0c\u9700\u5728\u7f16\u8f91\u5668\u5185\u8f93\u5165\u63d0\u4ea4\u4fe1\u606f\uff0c\u6309 q \u9000\u51fa <code>git commit [-a] [-m] \"&lt;Commit Message&gt;\"</code> \u81ea\u52a8\u5c06 tracked \u5e76\u4e14 modified \u7684\u6587\u4ef6 add\uff0c\u76f4\u63a5\u6807\u6ce8\u63d0\u4ea4\u4fe1\u606f <code>git commit --amend</code> \u4fee\u8ba2\u4e0a\u6b21\u63d0\u4ea4</p> <p>\u63d0\u4ea4\u65e5\u5fd7 <code>git log []\u9ed8\u8ba4/[-p]\u6700\u8be6\u7ec6/[--stat]\u5386\u53f2+\u66f4\u6539/[--oneline]\u7b80\u6d01\u7248</code>  \u7b7e\u51fa\u5230\u67d0\u6b21\u63d0\u4ea4 <code>git checkout &lt;HashAbstract&gt;</code></p>"},{"location":"Other/Git/#git_1","title":"Git \u5206\u652f","text":"<p>\u672c\u8d28\u4e0a\u4ec5\u4ec5\u662f\u6307\u5411\u63d0\u4ea4\u5bf9\u8c61\u7684\u53ef\u53d8\u6307\u9488\u3002 \u9ed8\u8ba4\u5206\u652f\u540d\u5b57\u662f master, HEAD \u6307\u5411\u5de5\u4f5c\u533a\u5f53\u524d\u6240\u5728\u7684\u63d0\u4ea4\u3002</p> <p>\u67e5\u770b\u5206\u652f <code>git branch []/[-v]\u8be6\u7ec6/[-vv]\u975e\u5e38\u8be6\u7ec6</code> \u521b\u5efa\u5206\u652f <code>git branch &lt;BranchName&gt;</code> \u7b7e\u51fa\u5230\u5206\u652f <code>git checkout &lt;BranchName&gt; [&lt;SrcBranchName&gt;]</code> <code>git checkout -b &lt;BranchName&gt; [&lt;SrcBranchName&gt;]</code> \u521b\u5efa\u5e76\u5207\u6362  <code>git checkout &lt;BranchName&gt; -f</code> \u4e22\u5f03\u6240\u6709\u4fee\u6539\uff0c\u5f3a\u5236\u5207\u6362 \u5220\u9664\u5206\u652f <code>git branch -d &lt;BranchName&gt;</code></p> <p>\u4ece\u5206\u652f\u5408\u5e76 <code>git merge &lt;SrcBranchName&gt;</code> \u4e24\u79cd\u60c5\u51b5\uff1a - FastForward\uff1a\u65e0\u51b2\u7a81\u81ea\u7136\u5408\u5e76 - CONFLICT\uff1a\u624b\u52a8\u89e3\u51b3\u51b2\u7a81 </p>"},{"location":"Other/Git/#git_2","title":"Git \u8fdc\u7a0b","text":"<p>\u8fdc\u7a0b\u662f\u6307\u6258\u7ba1\u5728\u7f51\u7edc\u4e2d\u7684\u4f60\u7684\u9879\u76ee\u7684\u7248\u672c\u5e93\u3002</p> <p>\u67e5\u770b\u8fdc\u7a0b <code>git remote [-v]</code> \u6dfb\u52a0\u8fdc\u7a0b <code>git remote add &lt;RemoteName&gt; &lt;RemoteURL&gt;</code> \u4f7f\u7528git clone\u514b\u9686\u7684 Git \u4ed3\u5e93\u4f1a\u81ea\u52a8\u6dfb\u52a0origin\u8fdc\u7a0b\u3002 \u5220\u9664\u8fdc\u7a0b <code>git remote remove &lt;RemoteName&gt;</code></p> <p>\u8fdc\u7a0b\u5206\u652f\u5f62\u5982 <code>&lt;RemoteName&gt;/&lt;BranchName&gt;</code> \u7684\u5f62\u5f0f\uff0c\u53ea\u8bfb \u4ece\u8fdc\u7a0b\u6293\u53d6  <code>git fetch &lt;RemoteName&gt;</code> \u63a8\u9001\u5230\u8fdc\u7a0b <code>git push &lt;RemoteName&gt; &lt;BranchName&gt;</code>git push  :` \u6307\u5b9a\u5206\u652f <p>\u8ffd\u8e2a\u8fdc\u7a0b\u5206\u652f <code>git checkout -b &lt;BranchName&gt; &lt;RemoteName&gt;/&lt;RemoteBranchName&gt;</code>\u4f7f\u7528git clone\u514b\u9686\u7684 Git \u4ed3\u5e93\u4f1a\u81ea\u52a8\u6dfb\u52a0origin/master\u8ffd\u8e2a \u8bbe\u7f6e\u8ffd\u8e2a <code>git branch -u &lt;RemoteName&gt;/&lt;RemoteBranchName&gt;</code> \u4ece\u8fdc\u7a0b\u62c9\u53d6 <code>git pull</code> <code>git pull &lt;RemoteName&gt; &lt;RemoteBranchName&gt;:&lt;LocalBranchName&gt;</code> \u6307\u5b9a\u5206\u652f</p>"},{"location":"Other/Git/#vim","title":"vim \u7f16\u8f91\u5668","text":"<p>\u8f93\u5165 <code>:q(\u9000\u51favim\u7f16\u8f91\u5668)</code> \u5373\u53ef\uff0c\u6216\u8005\u8f93\u5165 <code>:q!(\u5f3a\u5236\u9000\u51fa\u4e0d\u4fdd\u5b58)</code>\u3001<code>:[wq](\u4fdd\u5b58\u540e\u9000\u51fa)</code>\u3001<code>:wq!(\u5f3a\u5236\u4fdd\u5b58\u540e\u9000\u51fa)</code> \u4e5f\u53ef\u4ee5\u9000\u51fa\u7f16\u8f91\u5668\u3002</p>"},{"location":"Other/Git/#git-gui","title":"Git GUI","text":"<p>Git for VSCode GitHub Desktop</p>"},{"location":"Other/Git/#_8","title":"\u547d\u4ee4\u884c\u8bed\u6cd5","text":"<p><code>.</code> \u5f53\u524d\u76ee\u5f55 <code>..</code> \u4e0a\u4e00\u7ea7\u76ee\u5f55 <code>~</code> \u5f53\u524d\u7528\u6237\u7684\u5bb6\u76ee\u5f55 <code>-</code> \u4e0a\u4e00\u4e2a\u6240\u5728\u76ee\u5f55 <code>/</code> \u8def\u5f84\u5206\u9694\u7b26</p>"},{"location":"Other/Git/#git-commit","title":"Git Commit \u7684\u89c4\u8303","text":"<p>\u4ee5\u4e2d\u6587\u4e3a\u4e3b\uff0c\u53c2\u8003\u56fd\u9645\u901a\u7528\u7684 Conventional Commits\uff08\u7ea6\u5b9a\u5f0f\u63d0\u4ea4\uff09 \u7ed3\u6784\u3002\u4ee5\u4e0b\u4e3a\u4f60\u5236\u5b9a\u7684\u201c\u5c0f\u767d\u53cb\u597d\u578b\u201d\u4e2a\u4eba\u89c4\u8303\uff1a</p>"},{"location":"Other/Git/#_9","title":"\u4e00\u3001\u6838\u5fc3\u683c\u5f0f","text":"<p>\u63a8\u8350\u91c7\u7528\u4ee5\u4e0b\u7ed3\u6784\uff1a</p> <pre><code>&lt;\u7c7b\u578b&gt;: &lt;\u7b80\u77ed\u63cf\u8ff0&gt;\n\n[\u53ef\u9009\uff1a\u8be6\u7ec6\u63cf\u8ff0\uff0c\u89e3\u91ca\u4e3a\u4ec0\u4e48\u8981\u8fd9\u4e48\u6539]\n</code></pre>"},{"location":"Other/Git/#type","title":"\u4e8c\u3001\u5e38\u7528\u7c7b\u578b\uff08Type\uff09","text":"<p>\u8fd9\u662f\u89c4\u8303\u7684\u7075\u9b42\u3002\u4f60\u53ef\u4ee5\u76f4\u63a5\u5728\u4ee3\u7801\u4e2d\u4f7f\u7528\u8fd9\u4e9b\u82f1\u6587\u5173\u952e\u8bcd\uff08\u56e0\u4e3a\u5b83\u4eec\u662f\u884c\u4e1a\u9ed1\u8bdd\uff0c\u4e14\u80fd\u8ba9 IDE \u63d2\u4ef6\u81ea\u52a8\u8bc6\u522b\u751f\u6210\u56fe\u6807\uff09\uff0c\u540e\u9762\u8ddf\u4e2d\u6587\u63cf\u8ff0\u3002</p> \u7c7b\u578b \u5173\u952e\u8bcd \u4f7f\u7528\u573a\u666f \u529f\u80fd <code>feat</code> \u65b0\u589e\u4e86\u529f\u80fd\uff08Feature\uff09 \u4fee\u590d <code>fix</code> \u4fee\u590d\u4e86 Bug \u6587\u6863 <code>docs</code> \u4fee\u6539\u4e86 README\u3001\u6ce8\u91ca\u3001\u9879\u76ee\u6587\u6863\u7b49 \u6837\u5f0f <code>style</code> \u4e0d\u5f71\u54cd\u903b\u8f91\u7684\u4fee\u6539\uff08\u5982\u7a7a\u683c\u3001\u683c\u5f0f\u5316\u3001\u4fee\u9519\u522b\u5b57\uff09 \u91cd\u6784 <code>refactor</code> \u4ee3\u7801\u903b\u8f91\u4f18\u5316\uff08\u4e0d\u662f\u589e\u529f\u80fd\u4e5f\u4e0d\u662f\u6539 Bug\uff09 \u6027\u80fd <code>perf</code> \u63d0\u5347\u6027\u80fd\u3001\u8fd0\u884c\u901f\u5ea6\u7684\u6539\u52a8 \u6d4b\u8bd5 <code>test</code> \u589e\u52a0\u6216\u4fee\u6539\u6d4b\u8bd5\u7528\u4f8b \u6742\u52a1 <code>chore</code> \u6784\u5efa\u8fc7\u7a0b\u3001\u4f9d\u8d56\u5e93\u66f4\u65b0\u3001\u8f85\u52a9\u5de5\u5177\u6539\u52a8"},{"location":"Other/Git/#_10","title":"\u4e09\u3001\u5177\u4f53\u7684\u4e66\u5199\u793a\u4f8b","text":""},{"location":"Other/Git/#1","title":"1. \u65b0\u589e\u529f\u80fd","text":"<p><code>feat: \u589e\u52a0\u7528\u6237\u767b\u5f55\u754c\u9762\u7684\u624b\u673a\u53f7\u9a8c\u8bc1\u529f\u80fd</code></p>"},{"location":"Other/Git/#2-bug","title":"2. \u4fee\u590d Bug","text":"<p><code>fix: \u4fee\u590d\u4e86\u5728 iOS \u6d4f\u89c8\u5668\u4e0b\u6309\u94ae\u70b9\u51fb\u65e0\u6548\u7684\u95ee\u9898</code></p>"},{"location":"Other/Git/#3","title":"3. \u6539\u8fdb\u4ee3\u7801\uff08\u91cd\u6784\uff09","text":"<p><code>refactor: \u63d0\u53d6\u516c\u5171\u7ec4\u4ef6\u4e2d\u7684\u5197\u4f59\u903b\u8f91\uff0c\u4f18\u5316\u4ee3\u7801\u7ed3\u6784</code></p>"},{"location":"Other/Git/#4","title":"4. \u66f4\u65b0\u6587\u6863","text":"<p><code>docs: \u4fee\u6539\u9879\u76ee\u5b89\u88c5\u8bf4\u660e\uff0c\u8865\u5145\u73af\u5883\u53d8\u91cf\u914d\u7f6e\u6b65\u9aa4</code></p>"},{"location":"Other/Git/#5","title":"5. \u6742\u52a1\uff08\u5982\u66f4\u65b0\u5305\uff09","text":"<p><code>chore: \u5347\u7ea7 axios \u4f9d\u8d56\u7248\u672c\u5230 1.x</code></p>"},{"location":"Other/Git/#_11","title":"\u56db\u3001\u51e0\u6761\u5b9e\u7528\u7684\u201c\u8fdb\u9636\u201d\u539f\u5219","text":"<ol> <li>\u539f\u5b50\u5316\u63d0\u4ea4\uff1a \u4e00\u6b21 Commit \u53ea\u505a\u4e00\u4ef6\u4e8b\u3002\u4e0d\u8981\u6539\u4e86 Bug \u53c8\u987a\u4fbf\u5199\u4e86\u65b0\u529f\u80fd\u3002\u5982\u679c\u505a\u4e86\u4e24\u4ef6\u4e8b\uff0c\u5c31\u5206\u4e24\u6b21\u63d0\u4ea4\u3002</li> <li>\u7b80\u77ed\u6709\u529b\uff1a \u7b2c\u4e00\u884c\u63cf\u8ff0\u5c3d\u91cf\u63a7\u5236\u5728 50 \u4e2a\u5b57\u7b26\u4ee5\u5185\u3002\u5982\u679c\u8bf4\u4e0d\u6e05\u695a\uff0c\u53ef\u4ee5\u5728\u7a7a\u4e00\u884c\u540e\u5199\u8be6\u7ec6\u7684\u201c\u6b63\u6587\u201d\u3002</li> <li>\u7528\u201c\u5b8c\u6210\u65f6\u201d\u8fd8\u662f\u201c\u73b0\u5728\u65f6\u201d\uff1f \u4e2d\u6587\u4e60\u60ef\u7528\u201c\u589e\u52a0\u201d\u3001\u201c\u4fee\u590d\u201d\uff0c\u8fd9\u6bd4\u201c\u589e\u52a0\u4e86\u201d\u3001\u201c\u4fee\u590d\u4e86\u201d\u66f4\u7b80\u6d01\u3002</li> <li>\u5584\u7528 Emoji\uff08\u53ef\u9009\uff09\uff1a \u5f88\u591a\u5f00\u53d1\u8005\u559c\u6b22\u5728\u5f00\u5934\u52a0\u56fe\u6807\uff0c\u8ba9 Log \u770b\u8d77\u6765\u66f4\u7f8e\u89c2\u3002<ul> <li>\u2728 <code>feat:</code></li> <li>\ud83d\udc1b <code>fix:</code></li> <li>\ud83d\udcdd <code>docs:</code></li> <li>\ud83d\ude80 <code>perf:</code></li> </ul> </li> </ol>"},{"location":"Other/Git/#_12","title":"\u4e94\u3001\u7ed9\u5c0f\u767d\u7684\u8f85\u52a9\u5de5\u5177\u63a8\u8350","text":"<p>\u65e2\u7136\u4f60\u8fd8\u4e0d\u9700\u8981\u53c2\u4e0e\u5927\u578b\u9879\u76ee\uff0c\u53ef\u4ee5\u5229\u7528\u5de5\u5177\u6765\u5f3a\u8feb\u81ea\u5df1\u517b\u6210\u4e60\u60ef\uff1a 1.  VS Code \u63d2\u4ef6\uff1a<code>GitLens</code> \u6216 <code>Conventional Commits</code>     *   \u5b89\u88c5\u540e\uff0c\u5b83\u4f1a\u63d0\u4f9b\u4e00\u4e2a\u53ef\u89c6\u5316\u7684\u754c\u9762\uff0c\u8ba9\u4f60\u4e0b\u62c9\u9009\u62e9 <code>feat</code> \u6216 <code>fix</code>\uff0c\u4f60\u53ea\u9700\u8981\u586b\u7a7a\u5373\u53ef\u3002 2.  \u547d\u4ee4\u884c\uff08\u8fdb\u9636\uff09\uff1a<code>Commitizen</code>     *   \u8fd9\u662f\u4e00\u4e2a Node. js \u5de5\u5177\uff0c\u4f60\u8f93\u5165 <code>git cz</code> \u4e4b\u540e\uff0c\u5b83\u4f1a\u4e00\u6b65\u6b65\u95ee\u4f60\u95ee\u9898\uff0c\u6700\u540e\u81ea\u52a8\u751f\u6210\u7b26\u5408\u89c4\u8303\u7684\u6ce8\u91ca\u3002</p>"},{"location":"Other/Git/#_13","title":"\u603b\u7ed3\u4f60\u7684\u201c\u79c1\u4eba\u6a21\u677f\u201d\uff1a","text":"<pre><code>[\u56fe\u6807] \u7c7b\u578b: \u505a\u4e86\u4ec0\u4e48\u4e8b (\u4e3a\u4ec0\u4e48\u8fd9\u4e48\u505a)\n</code></pre> <p>\u575a\u6301\u8fd9\u4e2a\u4e60\u60ef\u4e24\u5468\uff0c\u4f60\u4f1a\u53d1\u73b0\u56de\u770b\u81ea\u5df1\u4ee3\u7801\u5386\u53f2\u65f6\uff0c\u6709\u4e00\u79cd\u5f3a\u8feb\u75c7\u88ab\u6cbb\u6108\u7684\u723d\u5feb\u611f\uff01</p>"}]}